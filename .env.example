# Database
DATABASE_URL=postgresql+psycopg://app:app@postgres:5432/payments

# Redis (idempotency / rate limit / event queue demo)
REDIS_URL=redis://redis:6379/0

# API security
JWT_SECRET=change-me-long-random
JWT_ISSUER=secure-payments-aml
ACCESS_TOKEN_MINUTES=30
ENCRYPTION_MASTER_KEY=change-me-32+bytes-base64-or-hex

# Stripe (use TEST keys)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# AML
AML_ALERT_THRESHOLD=70
HIGH_RISK_COUNTRIES=IR,KP,SY,CU,RU
